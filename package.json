{
  "name": "lg-luma",
  "version": "2.9.0",
  "private": true,
  "description": "A modern, remote-first webOS launcher.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4 <2"
  },
  "scripts": {
    "dev": "cargo run --locked --",
    "build": "bun run check:shaders && sh tools/build-webos.sh",
    "package": "bun run assets && bun run build && bun tools/package.mjs && bun tools/repository.mjs",
    "deploy": "bun run package && bun tools/deploy.mjs",
    "test": "bun run test:release && bun run test:home && bun run test:icons && bun run test:build && bun run test:shaders && cargo test --locked --workspace --all-features",
    "test:build": "bun test --timeout 60000 tests/build.test.mjs",
    "test:release": "bun test --timeout 60000 tests/release.test.mjs",
    "test:home": "bun test --timeout 60000 tests/home-splash.test.mjs tests/home-executable.test.mjs tests/sync-splash.test.mjs",
    "test:icons": "bun test --timeout 60000 tests/read-app-icon.test.mjs tests/brand-assets.test.mjs",
    "test:smoke": "bun tests/smoke.mjs && bun tests/brands-smoke.mjs && bun tests/weather-smoke.mjs && bun tests/translations-smoke.mjs",
    "test:brands": "bun tests/brands-smoke.mjs",
    "check": "bun run version:check && bun run lint && bun run check:types && bun run check:shaders && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "cargo fmt --all && oxfmt --write .",
    "format:check": "cargo fmt --all -- --check && oxfmt --check .",
    "assets": "bun tools/assets.mjs",
    "screenshots": "bun run assets && bun tools/screenshots.mjs",
    "assets:vector": "bun tools/vector-assets.mjs",
    "assets:brands": "bun tools/brand-assets.mjs",
    "assets:fonts": "bun tools/font-assets.mjs",
    "runtime": "bun tools/webos-runtime.mjs",
    "sdk": "bun tools/setup-webos-sdk.mjs",
    "test:weather": "bun tests/weather-smoke.mjs",
    "test:translations": "bun tests/translations-smoke.mjs",
    "changeset": "bun node_modules/@changesets/cli/bin.js",
    "version:release": "bun run changeset version && bun run version:sync && oxfmt --write CHANGELOG.md",
    "version:sync": "bun tools/sync-version.mjs",
    "version:check": "bun tools/sync-version.mjs --check",
    "check:types": "bun node_modules/typescript/bin/tsc --noEmit --project tsconfig.json",
    "check:shaders": "bun tools/check-shaders.mjs",
    "test:shaders": "bun test tests/shaders.test.mjs",
    "check:binary:container": "bun tools/check-container.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "@webos-tools/cli": "3.2.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "typescript": "latest"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "overrides": {
    "body-parser": "2.4.0"
  }
}
